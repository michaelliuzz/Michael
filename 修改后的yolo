# 兼容入口（原“修改后的yolo”）：拍一帧 -> YOLO11 检测 -> 栅格地图 -> grid.npy
#
# 原版本按 20 像素 = 1 格直接整除，地图没有真实尺度；现已改为调用
# deploy_raspberry_pi/rescue/geo_mapping.py：按相机 FOV + 飞行高度计算 GSD，
# 结合姿态把检测框投影到地面，再按米制分辨率栅格化并做膨胀处理。
# 人员（person）不再被当作障碍物，而是作为路径终点。
#
# 等价于:
#   python3 deploy_raspberry_pi/drone_node.py --model deploy_raspberry_pi/best_collapsed.pt \
#       deploy_raspberry_pi/best_person.pt --source picamera --altitude 10 --once
# 注意：原脚本的 OBSTACLE_CLASSES = ["person","rock","tree"] 与模型实际类别不符
#   （best_collapsed.pt 只有 "collapsed"，best_person.pt 只有 "person"），导致地图中没有障碍物。
# 其余参数（--altitude / --hfov / --res / --source 图片路径 等）可直接追加在本脚本后面。
import runpy
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent / "deploy_raspberry_pi"
MODEL_PATHS = [str(ROOT / "best_collapsed.pt"), str(ROOT / "best_person.pt")]  # 障碍 + 人员

argv = sys.argv[1:]
if "--model" not in argv:
    argv = ["--model", *MODEL_PATHS] + argv
if "--once" not in argv:
    argv.append("--once")
sys.argv = [str(ROOT / "drone_node.py")] + argv
runpy.run_path(str(ROOT / "drone_node.py"), run_name="__main__")
