# 兼容入口（原“astar”）：读取 grid.npy，A* 规划并打印字符可视化
#
# 算法已移至 deploy_raspberry_pi/rescue/planner.py，改进点：
#   - 默认 8 邻域，使用八方向距离启发式（原脚本 8 邻域用曼哈顿距离，会高估代价）
#   - 禁止对角穿过两个障碍格之间的缝
#   - 若存在 grid_meta.json（drone_node.py 生成），则使用其中的终点（空中发现的人员 / 最空旷区域）
#     并以米为单位输出路径长度
import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent / "deploy_raspberry_pi"))
from rescue.geo_mapping import nearest_free  # noqa: E402
from rescue.planner import astar, path_length_cells, render_ascii, simplify_path  # noqa: E402

grid = np.load("grid.npy")
H, W = grid.shape
meta = json.loads(Path("grid_meta.json").read_text()) if Path("grid_meta.json").exists() else {}

start = nearest_free(grid, (H - 2, W // 2))
goal = nearest_free(grid, tuple(meta["goal"]) if meta.get("goal") else (1, W // 2))

path = astar(grid, start, goal, allow_diag=True) if start and goal else None
print("Grid shape:", grid.shape)
print("Start:", start, "Goal:", goal, f"({meta.get('goal_kind', 'default')})")
if path is None:
    print("❌ 无路径（可能被障碍物完全挡住了）")
else:
    res = meta.get("resolution")
    length = path_length_cells(path)
    print("✅ 找到路径，格数:", len(path), f"| 长度 {length:.1f} 格" + (f" = {length * res:.2f} m" if res else ""))
    print("航点:", simplify_path(grid, path))
    print("\nLegend: '.'=free  '#'=obs  'o'=path  'S'=start  'G'=goal")
    print(render_ascii(grid, path, start, goal))
